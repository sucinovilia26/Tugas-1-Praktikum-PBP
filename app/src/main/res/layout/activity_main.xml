<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="#FAC2DD"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/formulir_pendaftaran"
        android:gravity="center"
        android:padding="12dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#090909" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pelatihan_desain_grafis"
        android:gravity="center"
        android:padding="22sp"
        android:textStyle="bold"
        android:textColor="#090909" />

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/foto_logo" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:hint="@string/input_nama"
        android:inputType="text"
        tools:ignore="Autofill, TextFieldSize" />
    
    <EditText
        android:id="@+id/etAge"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:hint="@string/input_umur"
        android:inputType="number"
        tools:ignore="Autofill, TextFieldSize" />
    
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="@string/submit" />
    
    <Button
        android:id="@+id/btnInfo"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="@string/info_event" />
    
</LinearLayout>